# Copy to .env.local (git-ignored) and fill in.
# These are read ONLY by the Vite dev/preview server (vite.config.ts). They have no VITE_
# prefix, so they are never bundled into browser code.

# Base URL of chime-messaging-go-api, without the /api suffix. e.g. QA:
MESSAGING_API_URL=https://messaging-api.example.jobtarget.com

# The KMS-encrypted token the API expects in the Authorization header.
# Get the environment's token from the team's secret store. Never commit it.
MESSAGING_API_TOKEN=

# Optional, client-visible: path the browser calls. Leave as /api to go through the proxy.
VITE_API_BASE_PATH=/api
